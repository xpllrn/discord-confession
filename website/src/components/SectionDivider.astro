---
/* Converging dashed-line divider, tinted with the site accent.
   Pass `flip` to mirror it vertically (upside-down version). */
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;
---
<div class:list={["section-divider", { "section-divider--flip": flip }]} aria-hidden="true">
  <svg viewBox="0 0 1510 193" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <g stroke="url(#sd-grad)" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="3 3">
      <path d="M-23 47.6944C794.5 282.024 774 -29.9761 1509.5 47.6943" />
      <path d="M-23 53.3507C794.5 287.68 774 -24.3198 1509.5 53.3505" />
      <path d="M-23 59.0069C794.5 293.336 774 -18.6636 1509.5 59.0068" />
      <path d="M-23 64.6632C794.5 298.993 774 -13.0073 1509.5 64.663" />
      <path d="M-23 13.7608C794.5 248.09 774 -63.9097 1509.5 13.7607" />
      <path d="M-23 19.4171C794.5 253.747 774 -58.2534 1509.5 19.4169" />
      <path d="M-23 25.0714C794.5 259.401 774 -52.5991 1509.5 25.0712" />
      <path d="M-23 30.7276C794.5 265.057 774 -46.9429 1509.5 30.7275" />
      <path d="M-23 36.3839C794.5 270.713 774 -41.2866 1509.5 36.3837" />
      <path d="M-23 42.0382C794.5 276.368 774 -35.6323 1509.5 42.038" />
    </g>
    <defs>
      <linearGradient id="sd-grad" x1="-26" y1="118" x2="1481" y2="189" gradientUnits="userSpaceOnUse">
        <stop offset="0.25" stop-color="#050505" />
        <stop offset="0.5" stop-color="#6fa3a6" />
        <stop offset="0.75" stop-color="#050505" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .section-divider {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    overflow: hidden;
    pointer-events: none;
  }
  .section-divider svg {
    display: block;
    width: 100%;
    /* Keep the curve's shape on narrow screens: don't squish below this,
       just let the ends crop off (container hides the overflow). */
    min-width: 1700px;
    height: 240px;
    flex-shrink: 0;
  }
  .section-divider--flip svg {
    transform: scaleY(-1);
  }
</style>
