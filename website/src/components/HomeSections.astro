---
import SectionDivider from "./SectionDivider.astro";
import Button from "./Button.astro";
import Faq from "./Faq.astro";
import { site } from "../data/site";
---

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-faint)]">Why Confession</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-4xl">
      Built for privacy-first communities
    </h2>
    <p class="mt-4 text-sm leading-relaxed text-[var(--color-dim)] sm:text-base">
      Anonymous confessions for Discord. Part of the <a class="underline decoration-[var(--color-line)] underline-offset-4 hover:text-[var(--color-fg)]" href="https://adore.rest">adore.rest</a> network.
    </p>
  </div>

  <div class="feature-grid mt-14">
        <article class="feature-card">
          <p class="feature-card__marker">##</p>
          <h3 class="feature-card__title">Anonymous posts</h3>
          <p class="feature-card__tag">privacy</p>
          <p class="feature-card__body">Members confess without revealing who they are. Authors stay hidden in the channel.</p>
        </article>
        <article class="feature-card">
          <p class="feature-card__marker">[]</p>
          <h3 class="feature-card__title">Optional review</h3>
          <p class="feature-card__tag">moderation</p>
          <p class="feature-card__body">Route submissions through a review channel before they go public.</p>
        </article>
        <article class="feature-card">
          <p class="feature-card__marker"><></p>
          <h3 class="feature-card__title">One-command setup</h3>
          <p class="feature-card__tag">setup</p>
          <p class="feature-card__body">/setup walks admins through confession and review channels in minutes.</p>
        </article>
        <article class="feature-card">
          <p class="feature-card__marker">~~</p>
          <h3 class="feature-card__title">Customization panel</h3>
          <p class="feature-card__tag">control</p>
          <p class="feature-card__body">Tune avatar, filters, and confession behavior from /panel.</p>
        </article>
        <article class="feature-card">
          <p class="feature-card__marker">!!</p>
          <h3 class="feature-card__title">Replies & reports</h3>
          <p class="feature-card__tag">safety</p>
          <p class="feature-card__body">Keep conversations going with anonymous replies and staff report tools.</p>
        </article>
        <article class="feature-card">
          <p class="feature-card__marker">**</p>
          <h3 class="feature-card__title">Part of adore.rest</h3>
          <p class="feature-card__tag">network</p>
          <p class="feature-card__body">Same network polish as adore and cupid — free to invite, support always nearby.</p>
        </article>
  </div>
</section>

<SectionDivider />

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-4xl">
      Ready when your server is
    </h2>
    <p class="mt-4 text-sm leading-relaxed text-[var(--color-dim)] sm:text-base">
      Invite Confession, explore the commands, and join support if you need a hand.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={site.invite} variant="glossy" external>Invite to Discord</Button>
      <Button href="/commands" variant="glossy">Explore commands</Button>
      <Button href={site.support} variant="glossy" external>Join support</Button>
    </div>
  </div>
</section>

<SectionDivider />

<section class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
  <div class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-4xl">FAQ</h2>
    <p class="mt-3 text-sm text-[var(--color-dim)]">Quick answers before you invite.</p>
  </div>
  <div class="mt-10">
    <Faq />
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .feature-card {
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-soft) 88%, transparent);
    border-radius: 1rem;
    padding: 1.25rem 1.3rem 1.35rem;
  }
  .feature-card__marker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-premium);
  }
  .feature-card__title {
    margin: 0.55rem 0 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .feature-card__tag {
    margin: 0.35rem 0 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }
  .feature-card__body {
    margin: 0.7rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-dim);
  }
</style>
