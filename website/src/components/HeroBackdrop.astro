---
/* Hero atmosphere comes entirely from the global site background (global.css).
   Only very sparse stars sit here, as part of the background — nothing framed on top. */
---
<div class="hero-backdrop" aria-hidden="true">
  <div class="hero-backdrop__stars"></div>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-backdrop__stars {
    position: absolute;
    inset: 0;
    opacity: 0.95;
    background-image:
      radial-gradient(1.4px 1.4px at 10% 20%, rgba(255, 255, 255, 0.85), transparent),
      radial-gradient(1px 1px at 22% 55%, rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(1.2px 1.2px at 35% 15%, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(1.4px 1.4px at 60% 28%, rgba(255, 255, 255, 0.7), transparent),
      radial-gradient(1px 1px at 72% 60%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1.5px 1.5px at 85% 18%, rgba(255, 255, 255, 0.78), transparent),
      radial-gradient(1.6px 1.6px at 15% 75%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(1px 1px at 40% 80%, rgba(255, 255, 255, 0.3), transparent),
      radial-gradient(1.2px 1.2px at 78% 82%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1.4px 1.4px at 8% 88%, rgba(111, 163, 166, 0.5), transparent),
      radial-gradient(1px 1px at 52% 78%, rgba(255, 255, 255, 0.28), transparent),
      radial-gradient(1.3px 1.3px at 68% 95%, rgba(111, 163, 166, 0.4), transparent),
      radial-gradient(1.4px 1.4px at 88% 72%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(1.2px 1.2px at 33% 40%, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1px 1px at 48% 32%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(1.3px 1.3px at 92% 45%, rgba(255, 255, 255, 0.5), transparent);
  }
</style>
