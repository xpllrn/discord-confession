---
interface Props {
  heading: string;
  updated?: string;
}
const { heading, updated } = Astro.props;
---
<article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{heading}</h1>
  {
    updated && (
      <p class="mt-2 text-sm text-[var(--color-faint)]">Last updated {updated}</p>
    )
  }

  <div class="prose-terminal mt-10 space-y-5 text-sm leading-relaxed text-[var(--color-dim)]">
    <slot />
  </div>
</article>

<style is:global>
  .prose-terminal h2 {
    color: var(--color-fg);
    font-size: 1rem;
    font-weight: 600;
    margin-top: 2rem;
    scroll-margin-top: 7rem;
  }
  .prose-terminal a {
    color: var(--color-glow);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-terminal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-terminal strong {
    color: var(--color-fg);
  }
</style>
