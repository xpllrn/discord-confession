---
import { site } from "../data/site";
const year = new Date().getFullYear();

const botLinks = [
  { label: "Invite", href: site.invite, external: true },
  { label: "Commands", href: "/commands" },
  { label: "FAQ", href: "/faq" },
  { label: "Status", href: "/status" },
  { label: "Support Server", href: site.support, external: true },
  { label: "adore.rest", href: "https://adore.rest", external: true },
];

const legalLinks = [
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
];
---
<footer class="border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-[1.2fr_1fr_1fr] sm:px-8 sm:py-16">
    <div class="flex flex-col justify-between gap-8">
      <a href="/" class="inline-flex items-center gap-3" aria-label={`${site.name} home`}>
        <img
          src="/brand/adore_logo.png?v=1"
          alt=""
          width="36"
          height="36"
          class="h-9 w-9 object-contain"
        />
        <span class="text-lg font-semibold tracking-tight" translate="no">{site.name}</span>
      </a>
      <p class="text-xs text-[var(--color-faint)]">
        Copyright © {year} {site.domain}. All rights reserved.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-fg)]">Bot</p>
      <ul class="mt-4 space-y-2.5 text-sm text-[var(--color-dim)]">
        {
          botLinks.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener noreferrer" : undefined}
                class="hover:text-[var(--color-fg)]"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-fg)]">Legal</p>
      <ul class="mt-4 space-y-2.5 text-sm text-[var(--color-dim)]">
        {
          legalLinks.map((l) => (
            <li>
              <a href={l.href} class="hover:text-[var(--color-fg)]">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            onclick="window.openConsent && window.openConsent()"
            class="hover:text-[var(--color-fg)]"
          >
            Cookie preferences
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>
