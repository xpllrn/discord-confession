---
import { faqs } from "../data/site";
---
<section id="faq" class="scroll-mt-28 relative mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="faq-h">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--color-faint)]">help</p>
  <h1 id="faq-h" class="mt-3 text-3xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-4xl">
    FAQ
  </h1>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-dim)]">
    Common questions about confession — setup, privacy, and support.
  </p>

  <div class="mt-10 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
    {
      faqs.map((faq) => (
        <details id={faq.id} class="group scroll-mt-28">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm text-[var(--color-fg)] hover:text-[var(--color-glow)] sm:py-5">
            <h2 class="font-medium">{faq.q}</h2>
            <span class="shrink-0 text-[var(--color-faint)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="pb-4 text-sm leading-relaxed text-[var(--color-dim)] sm:pb-5">
            {faq.a}
          </p>
        </details>
      ))
    }
  </div>
</section>

<script>
  const openFaqFromHash = () => {
    const id = decodeURIComponent(location.hash.replace(/^#/, ""));
    if (!id || id === "faq") return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  openFaqFromHash();
  window.addEventListener("hashchange", openFaqFromHash);
</script>
