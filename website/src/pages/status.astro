---
import Layout from "../layouts/Layout.astro";
import { site, features } from "../data/site";
---
<Layout title="status" description={`Live status for ${site.name}.`}>
  <section class="mx-auto max-w-3xl px-5 pb-24 pt-28 sm:px-8">
    <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-faint)]">status</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--color-fg)]">Status</h1>
    <p class="mt-3 text-sm text-[var(--color-dim)]">Live health for {site.name}.</p>

    <div id="status-card" class="mt-10 rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg-soft)] p-6">
      <p class="text-sm text-[var(--color-faint)]">Checking…</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-faint)]">Why Confession</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-4xl">
        Built for privacy-first communities
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-dim)] sm:text-base">
        Anonymous confessions for Discord. Part of the <a class="underline decoration-[var(--color-line)] underline-offset-4 hover:text-[var(--color-fg)]" href="https://adore.rest">adore.rest</a> network.
      </p>
    </div>

    <div class="feature-grid mt-14">
      {
        features.map((feature) => (
          <article class="feature-card">
            <p class="feature-card__marker">{feature.marker}</p>
            <h3 class="feature-card__title">{feature.title}</h3>
            <p class="feature-card__tag">{feature.tag}</p>
            <p class="feature-card__body">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ botName: "confession" }}>
  (() => {
    const el = document.getElementById("status-card");
    const fmt = (n) => (n == null ? "—" : Number(n).toLocaleString("en-US"));
    const cell = (label, value) =>
      '<div><dt class="text-[var(--color-faint)]">' + label + '</dt><dd class="mt-1 text-[var(--color-fg)]">' + value + "</dd></div>";
    fetch("/api/status").then(async (res) => {
      const data = await res.json().catch(() => ({}));
      const online = String(data.status || "").toLowerCase() === "online" || (res.ok && data.guilds != null);
      el.innerHTML =
        '<div class="flex items-center justify-between gap-4">' +
        '<div><p class="text-lg font-semibold text-[var(--color-fg)]">' + (online ? "Operational" : "Degraded") + "</p>" +
        '<p class="mt-1 text-sm text-[var(--color-dim)]">' + (data.bot || botName) + "</p></div>" +
        '<span class="text-sm ' + (online ? "text-[var(--color-ok)]" : "text-[var(--color-noir-crimson)]") + '">' +
        (data.status || (online ? "online" : "offline")) + "</span></div>" +
        '<dl class="mt-6 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">' +
        cell("Latency", data.latency_ms != null ? data.latency_ms + " ms" : "—") +
        cell("Servers", fmt(data.guilds)) +
        cell("Users", fmt(data.users)) +
        cell("Checked", data.checked_at ? new Date(data.checked_at * 1000).toLocaleString() : "—") +
        "</dl>";
    }).catch(() => {
      el.innerHTML = '<p class="text-sm text-[var(--color-noir-crimson)]">Could not reach the status API.</p>';
    });
  })();
</script>

<style>
  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .feature-card {
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-soft) 88%, transparent);
    border-radius: 1rem;
    padding: 1.25rem 1.3rem 1.35rem;
  }
  .feature-card__marker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-premium);
  }
  .feature-card__title {
    margin: 0.55rem 0 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .feature-card__tag {
    margin: 0.35rem 0 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }
  .feature-card__body {
    margin: 0.7rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-dim);
  }
</style>
