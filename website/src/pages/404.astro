---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---
<Layout title="404">
  <section class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-5 text-center sm:px-8">
    <p class="font-mono text-5xl font-semibold tracking-tight text-[var(--color-fg)] sm:text-6xl">404</p>
    <h1 class="mt-4 text-lg font-semibold">Page not found</h1>
    <p class="mt-2 text-sm text-[var(--color-dim)]">
      This page doesn’t exist - head back home.
    </p>
    <div class="mt-8">
      <Button href="/" variant="primary">Back home</Button>
    </div>
  </section>
</Layout>
